{
	"name": "Phobot",
	"version": "1.0.0",
	"description": "discord bot for controlling server",
	"type": "module",
	"engines": {
		"node": ">=18.x"
	},
	"main": "src/main.ts",
	"scripts": {
        "prepare": "ts-patch install -s",
        "dev": "NODE_ENV=development npx tsx watch .",
        "build": "rm -rf build && tspc -p tsconfig.json",
        "staging": "NODE_ENV=staging node build/src/main.js",
		"register": "npx tsx deploy-commands.ts",
		"register-global": "npx tsx deploy-commands.ts --global",
		"deploy": "NODE_ENV=production pm2 start build/src/main.js --name phobot --cron-restart=\"0 5 * * *\""
	},
	"dependencies": {
		"child_process": "^1.0.2",
		"discord.js": "^14.21.0",
		"dotenv": "^17.2.1",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"ts-patch": "^3.3.0",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"typescript-transform-paths": "^3.5.5"
	}
}
